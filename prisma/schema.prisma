generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GameState {
  // Jeden verzovaný JSONB záznam drží společný stav hry.
  id      String @id
  payload Json   @db.JsonB
  // Číslo verze se zvyšuje při zápisu a chrání souběžné aktualizace.
  version BigInt @default(0)

  @@map("game_state")
}

model LoginThrottle {
  // Klíč tvoří hash týmu a IP; záznamy omezují hádání hesel.
  key             String   @id
  // Čítač chybných přihlášení a začátek jeho časového okna.
  attempts        Int      @default(0)
  windowStartedAt DateTime @db.Timestamptz(3) @map("window_started_at")

  @@map("login_throttles")
}

model AuthSession {
  // Token se ukládá jen jako hash, aby šlo relace serverově zneplatnit.
  tokenHash  String   @id @map("token_hash")
  // Firebase UID a role ověřují, komu relace patří.
  firebaseUid String @map("firebase_uid")
  role       String
  teamId     String?  @map("team_id")
  expiresAt  DateTime @db.Timestamptz(3) @map("expires_at")

  @@index([expiresAt])
  @@map("auth_sessions")
}

model TeamQrCredential {
  // Pro každý tým existuje právě jeden aktivní, hashovaný QR přístup.
  teamId    String   @id @map("team_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@map("team_qr_credentials")
}

model TeamQrCard {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  tokenCipher String? @map("token_cipher")
  teamId    String?  @unique @map("team_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@map("team_qr_cards")
}

model Manager {
  // Přihlašovací účet správce; heslo se ukládá pouze jako hash.
  id           String   @id
  username     String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@map("managers")
}

model SupportMessage {
  id         String   @id
  teamId     String   @map("team_id")
  teamName   String   @map("team_name")
  senderRole String   @map("sender_role")
  content    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@index([teamId, createdAt])
  @@map("support_messages")
}
